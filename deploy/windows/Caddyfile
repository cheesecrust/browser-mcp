# HTTPS front for the Windows host. Caddy obtains and renews the certificate automatically;
# DOMAIN comes from .env (the scheduled task passes --envfile). Same as the root Caddyfile
# except that the server is a local process instead of a compose service.
{$DOMAIN} {
    reverse_proxy 127.0.0.1:3000 {
        # Streamable HTTP keeps SSE streams open; do not buffer or time them out.
        flush_interval -1
        transport http {
            read_timeout 0
            write_timeout 0
        }
    }
}
