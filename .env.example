# --- Who may use the server: Kakao Login (recommended) and/or static tokens ---

# Kakao Login: people sign in with their Kakao account; only the accounts listed in
# BROWSER_MCP_ALLOWED_USERS (Kakao user ids and/or e-mails, "*" = everyone) may use the server.
# Register the app at https://developers.kakao.com and add
#   <BROWSER_MCP_PUBLIC_URL>/oauth/kakao/callback
# as a Redirect URI under Kakao Login.
BROWSER_MCP_PUBLIC_URL=https://browser.example.com
BROWSER_MCP_KAKAO_CLIENT_ID=rest-api-key-from-kakao-developers
BROWSER_MCP_KAKAO_CLIENT_SECRET=client-secret-from-kakao-developers
BROWSER_MCP_ALLOWED_USERS=123456789,someone@example.com
# Request the e-mail consent item if you allow users by e-mail (the item must be enabled in the app).
#BROWSER_MCP_KAKAO_SCOPE=account_email
# Services that ask for a client id and secret up front (PlayMCP): client_id:client_secret[:redirect_uri]
# The redirect URI may end with "*" (prefix); several URIs are separated by "|", several clients by ";".
#BROWSER_MCP_OAUTH_CLIENTS=playmcp:<random secret of 16+ characters>:https://playmcp.kakao.com/<callback from the e-mail>

# Static tokens: one "token:user" pair per user, comma separated. Generate tokens with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
#BROWSER_MCP_TOKENS=replace-with-a-long-random-token:alice,another-long-random-token:bob

# Server-issued tokens: POST /tokens issues one, GET /tokens lists them, DELETE /tokens/<user> revokes.
# BROWSER_MCP_ADMIN_TOKEN (16+ characters) protects those calls; leave it out only for a sandbox.
#BROWSER_MCP_ISSUE_TOKENS=1
#BROWSER_MCP_ADMIN_TOKEN=<random secret of 16+ characters>

# Visible Chrome under a virtual display. Some sites answer 403 to any headless browser and to
# Playwright's own Chromium build (coupang.com does both); real Google Chrome with a window passes.
# The image installs Chrome and runs the server under Xvfb when BROWSER_MCP_HEADLESS=0.
#BROWSER_MCP_HEADLESS=0
#BROWSER_MCP_CHANNEL=chrome
#BROWSER_MCP_BROWSER_ARGS=--disable-blink-features=AutomationControlled

# Optional overrides (defaults shown).
#BROWSER_MCP_IDLE_TIMEOUT=900
#BROWSER_MCP_MAX_SESSIONS=20
#BROWSER_MCP_MAX_SESSIONS_PER_USER=3
#BROWSER_MCP_PROXY=http://proxy.example.com:3128

# Where the plain-HTTP port is exposed on the host (127.0.0.1 keeps it private to a local reverse proxy).
#BROWSER_MCP_BIND=127.0.0.1

# Public host name for the Caddy HTTPS profile.
#DOMAIN=browser.example.com
