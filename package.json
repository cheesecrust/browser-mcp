{
  "name": "browser-mcp",
  "version": "0.1.0",
  "description": "MCP server that lets AI agents control a real browser through Playwright",
  "type": "module",
  "private": true,
  "license": "MIT",
  "bin": {
    "browser-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "npm run build && tsx test/smoke.test.ts",
    "inspector": "npx @modelcontextprotocol/inspector node dist/index.js",
    "browsers:install": "playwright install chromium"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.3.1",
    "playwright": "^1.64.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.3.1",
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
